  {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Git pull",
        "type": "shell",
        "command": "git reset --hard origin/main",
        "presentation": { "panel": "dedicated", "group": "setup", "close": true },
      },
      {
        "label": "Preparar backend",
        "type": "shell",
        "command": "if (-not (Test-Path venv)) { python -m venv venv }; ./venv/Scripts/python.exe -m pip install -r ./requirements_dev.txt",
        "presentation": { "panel": "dedicated", "group": "setup", "close": true },
      },
      {
        "label": "Preparar frontend",
        "type": "shell",
        "command": "npm install",
        "options": { "cwd": "${workspaceFolder}/frontend", "env": { "PATH": "${workspaceFolder}\\venv\\Scripts;${env:PATH}" } },
        "presentation": { "panel": "dedicated", "group": "setup", "close": true },
      },
      {
        "label": "Backend (uvicorn)",
        "type": "shell",
        "command": "../venv/Scripts/python.exe -m uvicorn main:app --reload",
        "options": { "cwd": "${workspaceFolder}/backend" },
        "presentation": { "group": "dev" },
      },
      {
        "label": "Frontend (npm)",
        "type": "shell",
        "command": "npm run dev",
        "options": { "cwd": "${workspaceFolder}/frontend", "env": { "PATH": "${workspaceFolder}\\venv\\Scripts;${env:PATH}" } },
        "presentation": { "group": "dev" },
      },
      {
        "label": "Preparar servidores",
        "dependsOn": ["Preparar backend", "Preparar frontend"],
        "dependsOrder": "sequence",
        "problemMatcher": [],
      },
      {
        "label": "Iniciar servidores",
        "dependsOn": ["Backend (uvicorn)", "Frontend (npm)"],
        "runOptions": {"runOn": "folderOpen"},
        "problemMatcher": [],
      },
      {
        "label": "Update",
        "dependsOn": ["Git pull", "Preparar servidores", "Iniciar servidores"],
        "dependsOrder": "sequence",
        "problemMatcher": [],
      },
    ]
  }